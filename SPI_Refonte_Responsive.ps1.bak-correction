/** Tableau de bord métier, conçu d'abord pour les écrans mobiles. */
@Composable
fun DashboardScreen(
    surClicNotifications: () -> Unit,
    surClicProfil: () -> Unit,
    surClicSecteur: () -> Unit,
    surClicTresorerie: () -> Unit,
    surClicRegistre: () -> Unit,
    surClicRessources: () -> Unit,
    surClicTaches: () -> Unit,
    surClicAlertes: () -> Unit,
    surClicSuggestions: () -> Unit,
    surClicImports: () -> Unit,
    surClicAudit: () -> Unit,
    surClicFactures: () -> Unit,
    surClicConformite: () -> Unit,
    surClicAdministration: () -> Unit,
    surClicPilotage: () -> Unit,
    viewModel: DashboardViewModel = hiltViewModel(),
) {
    val etat by viewModel.uiState.collectAsStateWithLifecycle()
    val badgeViewModel: NotificationBadgeViewModel = hiltViewModel()
    val nombreNotifs by badgeViewModel.compte.collectAsStateWithLifecycle()

    Scaffold(
        containerColor = MaterialTheme.colorScheme.background,
        topBar = {
            SpiPmeTopBar(
                secteurActifNom = etat.secteurActifNom,
                nombreNotificationsNonLues = nombreNotifs,
                surClicSecteur = surClicSecteur,
                surClicNotifications = surClicNotifications,
                surClicProfil = surClicProfil,
            )
        },
    ) { paddingInterne ->
        when {
            etat.chargement -> Column(
                modifier = Modifier
                    .fillMaxSize()
                    .padding(paddingInterne)
                    .padding(horizontal = 24.dp),
                horizontalAlignment = Alignment.CenterHorizontally,
                verticalArrangement = Arrangement.Center,
            ) {
                CircularProgressIndicator()
                Spacer(Modifier.height(16.dp))
                Text(
                    text = "Préparation de votre tableau de bord…",
                    style = MaterialTheme.typography.bodyMedium,
                    color = MaterialTheme.colorScheme.onSurfaceVariant,
                    textAlign = TextAlign.Center,
                )
            }

            etat.echecComplet -> Box(
                modifier = Modifier
                    .fillMaxSize()
                    .padding(paddingInterne)
                    .padding(24.dp),
                contentAlignment = Alignment.Center,
            ) {
                Column(horizontalAlignment = Alignment.CenterHorizontally) {
                    Icon(
                        imageVector = Icons.Filled.ErrorOutline,
                        contentDescription = null,
                        tint = MaterialTheme.colorScheme.error,
                    )
                    Spacer(Modifier.height(12.dp))
                    Text(
                        text = etat.messageErreur ?: "Les données du tableau de bord sont momentanément indisponibles.",
                        color = MaterialTheme.colorScheme.onSurface,
                        style = MaterialTheme.typography.bodyLarge,
                        textAlign = TextAlign.Center,
                    )
                    Spacer(Modifier.height(12.dp))
                    TextButton(onClick = viewModel::rafraichir) { Text("Réessayer") }
                }
            }

            else -> LazyVerticalGrid(
                // Deux colonnes sur les téléphones courants, une seule sur les écrans très étroits.
                columns = GridCells.Adaptive(minSize = 150.dp),
                modifier = Modifier
                    .fillMaxSize()
                    .padding(paddingInterne),
                contentPadding = PaddingValues(start = 16.dp, top = 12.dp, end = 16.dp, bottom = 28.dp),
                horizontalArrangement = Arrangement.spacedBy(12.dp),
                verticalArrangement = Arrangement.spacedBy(12.dp),
            ) {
                item(span = { GridItemSpan(maxLineSpan) }) {
                    Column(modifier = Modifier.fillMaxWidth().padding(bottom = 4.dp)) {
                        Text(
                            text = "Tableau de bord",
                            style = MaterialTheme.typography.headlineMedium,
                            fontWeight = FontWeight.Bold,
                            color = MaterialTheme.colorScheme.onBackground,
                        )
                        Spacer(Modifier.height(4.dp))
                        Text(
                            text = "Pilotez votre activité en un coup d’œil.",
                            style = MaterialTheme.typography.bodyLarge,
                            color = MaterialTheme.colorScheme.onSurfaceVariant,
                        )
                    }
                }

                if (!etat.messageErreur.isNullOrBlank() && !etat.echecComplet) {
                    item(span = { GridItemSpan(maxLineSpan) }) {
                        Card(
                            modifier = Modifier.fillMaxWidth(),
                            shape = RoundedCornerShape(14.dp),
                            colors = CardDefaults.cardColors(
                                containerColor = MaterialTheme.colorScheme.surfaceVariant,
                            ),
                        ) {
                            Text(
                                text = etat.messageErreur.orEmpty(),
                                modifier = Modifier.fillMaxWidth().padding(14.dp),
                                style = MaterialTheme.typography.bodyMedium,
                                color = MaterialTheme.colorScheme.onSurfaceVariant,
                            )
                        }
                    }
                }

                item(span = { GridItemSpan(maxLineSpan) }) {
                    Text(
                        text = "Indicateurs clés",
                        style = MaterialTheme.typography.titleLarge,
                        fontWeight = FontWeight.SemiBold,
                        modifier = Modifier.padding(top = 4.dp, bottom = 2.dp),
                    )
                }

                etat.resumeTresorerie?.let { resume ->
                    item {
                        CarteDashboard(
                            titre = "Trésorerie",
                            valeurPrincipale = "${resume.soldeDisponible}",
                            sousTitre = "Solde disponible",
                            couleur = MaterialTheme.colorScheme.primary,
                            surClic = surClicTresorerie,
                        )
                    }
                }
                etat.resumeRegistre?.let { resume ->
                    item {
                        CarteDashboard(
                            titre = "Registre",
                            valeurPrincipale = "${resume.total}",
                            sousTitre = "${resume.actives} actives",
                            couleur = MaterialTheme.colorScheme.primary,
                            surClic = surClicRegistre,
                        )
                    }
                }
                etat.resumeRessources?.let { resume ->
                    item {
                        CarteDashboard(
                            titre = "Ressources",
                            valeurPrincipale = "${resume.total}",
                            sousTitre = "${resume.critiques} critiques",
                            couleur = if (resume.critiques > 0) MaterialTheme.colorScheme.error else SpiPmeTheme.extendedColors.succes,
                            surClic = surClicRessources,
                        )
                    }
                }
                etat.resumeTaches?.let { resume ->
                    item {
                        CarteDashboard(
                            titre = "Tâches",
                            valeurPrincipale = "${resume.total}",
                            sousTitre = "${resume.enRetard} en retard",
                            couleur = if (resume.enRetard > 0) MaterialTheme.colorScheme.error else SpiPmeTheme.extendedColors.succes,
                            surClic = surClicTaches,
                        )
                    }
                }
                etat.resumeAlertes?.let { resume ->
                    item {
                        CarteDashboard(
                            titre = "Alertes",
                            valeurPrincipale = "${resume.critiques}",
                            sousTitre = "Critiques actives",
                            couleur = if (resume.critiques > 0) MaterialTheme.colorScheme.error else SpiPmeTheme.extendedColors.succes,
                            surClic = surClicAlertes,
                        )
                    }
                }
                etat.resumeSuggestions?.let { resume ->
                    item {
                        CarteDashboard(
                            titre = "Suggestions IA",
                            valeurPrincipale = "${resume.enAttente}",
                            sousTitre = "En attente",
                            couleur = SpiPmeTheme.extendedColors.ia,
                            surClic = surClicSuggestions,
                        )
                    }
                }

                item(span = { GridItemSpan(maxLineSpan) }) {
                    Text(
                        text = "Accès rapide aux modules",
                        style = MaterialTheme.typography.titleLarge,
                        fontWeight = FontWeight.SemiBold,
                        modifier = Modifier.padding(top = 12.dp, bottom = 2.dp),
                    )
                }
                item {
                    CarteAccesModule("Registre", "Clients, fournisseurs et entités", surClicRegistre)
                }
                item {
                    CarteAccesModule("Ressources", "Suivi des ressources et des stocks", surClicRessources)
                }
                item {
                    CarteAccesModule("Trésorerie", "Transactions et situation financière", surClicTresorerie)
                }
                item {
                    CarteAccesModule("Tâches", "Actions et échéances", surClicTaches)
                }
                item {
                    CarteAccesModule("Alertes", "Événements nécessitant une attention", surClicAlertes)
                }
                item {
                    CarteAccesModule("Suggestions IA", "Recommandations et analyses", surClicSuggestions)
                }
                item {
                    CarteAccesModule("Imports", "Importer et contrôler des données", surClicImports)
                }
                item {
                    CarteAccesModule("Journal d’audit", "Historique des événements", surClicAudit)
                }
                item {
                    CarteAccesModule("Factures", "Suivi des factures", surClicFactures)
                }
                item {
                    CarteAccesModule("Conformité", "Contrôles et obligations", surClicConformite)
                }
                item {
                    CarteAccesModule("Administration", "Utilisateurs et rôles", surClicAdministration)
                }
                item {
                    CarteAccesModule("Pilotage intelligent", "Vue approfondie de l’activité", surClicPilotage)
                }
            }
        }
    }
}

